celexperts.com\\\/#\\\/schema\\\/person\\\/37253d96ac286ae264fb4e4ac051ffc7\"},\"headline\":\"Utilise Excel For Accounting &#038; Finance\",\"datePublished\":\"2020-03-17T08:48:28+00:00\",\"dateModified\":\"2023-05-17T09:55:14+00:00\",\"mainEntityOfPage\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/\"},\"wordCount\":1235,\"publisher\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/#organization\"},\"image\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/www.theexcelexperts.com\\\/wp-content\\\/uploads\\\/2020\\\/03\\\/excel-for-accounting.jpg\",\"articleSection\":[\"Excel\"],\"inLanguage\":\"en-GB\"},{\"@type\":\"WebPage\",\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/\",\"url\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/\",\"name\":\"Utilise Excel For Accounting & Finance - The Excel Experts\",\"isPartOf\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/#website\"},\"primaryImageOfPage\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/#primaryimage\"},\"image\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/#primaryimage\"},\"thumbnailUrl\":\"https:\\\/\\\/www.theexcelexperts.com\\\/wp-content\\\/uploads\\\/2020\\\/03\\\/excel-for-accounting.jpg\",\"datePublished\":\"2020-03-17T08:48:28+00:00\",\"dateModified\":\"2023-05-17T09:55:14+00:00\",\"description\":\"How to get the most out of Excel spreadsheets in accountancy & finance. Tips including financial formulas, analysing financial data & pivot tables\",\"breadcrumb\":{\"@id\":\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/#breadcrumb\"},\"inLanguage\":\"en-GB\",\"potentialAction\":[{\"@type\":\"ReadAction\",\"target\":[\"https:\\\/\\\/www.theexcelexperts.com\\\/excel-for-accounting\\\/\"]}]},{\"@type\":\"ImageObject\",\"inLanguage\":\"en-GB\",\"@id\":\"https:\\\/\\\/w